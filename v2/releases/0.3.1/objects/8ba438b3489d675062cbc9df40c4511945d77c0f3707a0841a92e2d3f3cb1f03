"""One input-producing job per Android display across LB desktop clients."""

from contextlib import contextmanager
from hashlib import sha256


@contextmanager
def device_lease(folder, address, display):
    folder.mkdir(parents=True, exist_ok=True)
    key = sha256(f"{address}/{display}".encode()).hexdigest()
    with (folder / (key + ".lock")).open("a+b") as handle:
        import msvcrt

        handle.seek(0)
        try:
            msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
        except OSError as exc:
            raise ValueError("此游戏显示屏已有任务在运行，请先停止当前任务。") from exc
        try:
            yield
        finally:
            handle.seek(0)
            msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
